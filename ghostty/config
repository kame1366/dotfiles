# --- シェルの設定 (Fish起動) ---
# 起動するシェルをfishに設定します。
# Ubuntuでのfishの標準的なパスを使用していますが、インストール方法によっては異なる場合があります。
# もし`which fish`で確認したパスと異なる場合は、適宜修正してください。
command = /usr/bin/bash

# Ghosttyのシェル連携をfish用に設定します。
# これにより、プロンプトのマークやジャンプなどの機能が適切に動作します。
shell-integration = fish

# --- 半透明 ---
# 背景の不透明度を設定します。0.0（完全な透明）から1.0（不透明）までの値です。
# 半透明にするには1.0より小さい値を指定します。
background-opacity = 0.90 

# 背景に適用するぼかし（Blur）の半径を設定します。
# この値が大きいほど、背景が強くぼかされます（アクリル効果）。
# 値は環境や好みに応じて調整してください。
background-blur-radius = 20

# --- その他の推奨設定 (必要に応じて変更) ---
# お好みのテーマを設定します（例: 'nord'や'gruvbox'など）。
theme = Xcode Dark hc

# 使用するフォントファミリーとサイズを設定します。
font-family = "Hack Nerd Font"
font-size = 14.0

# カーソルのスタイルを設定します（例: 'block', 'bar', 'underline'）。
cursor-style = block

# ウィンドウのパディングを設定（見た目の調整）
# window-padding-x = 10
# window-padding-y = 10

# --- ウィンドウサイズの指定 ---
# 起動時のウィンドウの幅を文字数（列数）で指定します。
window-width = 130 

# 起動時のウィンドウの高さを文字数（行数）で指定します。
window-height = 40
